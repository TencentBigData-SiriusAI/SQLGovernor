# Paths
DATABASE_DIR=/path/to/test_databases
TABLES_FILE_PATH=/path/to/test_tables.json
TEST_FILE_PATH=/path/to/test.json
OFFLINE_SCHEMA_PATH=/path/to/schema_cache.json

# Optional few-shot assets. Leave empty to disable retrieval-based few-shot prompts.
FEW_SHOT_FILE=
FEW_SHOT_EMBEDDINGS_FILE=
FEW_SHOT_EMBEDDING_ENDPOINT=
FEW_SHOT_EMBEDDING_MODEL=
FEW_SHOT_EMBEDDING_API_KEY=

# Domain-adapted generation model (the paper's SQLGovernor text-to-SQL model, CPT+SFT+RL).
# Serve it behind an OpenAI-compatible endpoint and fill in the matching model name.
SQL_GENERATION_SIMPLE_BASE_URL=http://127.0.0.1:8082/v1
SQL_GENERATION_SIMPLE_MODEL_NAME=SQLGOVERNOR-GEN
SQL_GENERATION_SIMPLE_API_KEY=none
SQL_GENERATION_SIMPLE_BATCH_SIZE=16

SQL_GENERATION_MODERATE_BASE_URL=http://127.0.0.1:8084/v1
SQL_GENERATION_MODERATE_MODEL_NAME=SQLGOVERNOR-GEN-V2
SQL_GENERATION_MODERATE_API_KEY=none
SQL_GENERATION_MODERATE_BATCH_SIZE=16

# External reasoning model used by repair, diagnosis, and timeout-specialist stages.
MODEL_QWEN3_235B_BASE_URL=https://example.com/v1
MODEL_QWEN3_235B_MODEL_NAME=qwen3-235b
MODEL_QWEN3_235B_API_KEY=
MODEL_QWEN3_235B_BATCH_SIZE=4

# Optional external secondary model. NOT used by the single-pass / candidate-selection
# setting reported in the paper (Sec. 8.3.3). Uncomment and append to SQL_GEN_PROFILE_*
# only if your reproduction needs an additional candidate source.
# MODEL_GEMINI_3_PRO_BASE_URL=https://example.com/v1
# MODEL_GEMINI_3_PRO_MODEL_NAME=gemini-3-pro-preview
# MODEL_GEMINI_3_PRO_API_KEY=
# MODEL_GEMINI_3_PRO_BATCH_SIZE=1

# Generation and repair
SQL_GENERATION_MODEL=sql-generation-model-simple
SQL_GENERATION_BATCH_SIZE=1
SQL_GENERATION_MAX_TOKENS=12000
SQL_SELECTION_MAX_TOKENS=12000
SQL_GENERATION_VOTE_WORKERS=1
SQL_RESULT_VOTING_TRIPLE_LIMIT=32

SQL_CORRECTION_MODEL=qwen3-235b
PHASE4_5_MODEL=qwen3-235b
PHASE5_REGEN_MODEL=qwen3-235b
PHASE5_REGEN_BATCH_SIZE=1
PHASE5_REGEN_CANDIDATE_COUNT=16
PHASE5_REGEN_MAX_ROUNDS=16

# Single-pass / candidate-selection generation profiles (Sec. 8.3.3): the trained
# generation model only, no external secondary model.
SQL_GEN_PROFILE_SIMPLE=sqlgovernor-gen:16:1:agentar_primary:1.0
SQL_GEN_PROFILE_MODERATE=sqlgovernor-gen-v2:16:1:agentar_primary:1.2
SQL_GEN_PROFILE_CHALLENGING=sqlgovernor-gen-v2:16:1:agentar_primary:1.2

# Reward (selection) model
RM_MODEL_NAME=SQL-SELECTION-MODEL
RM_BASE_URL=http://127.0.0.1:8080/v1
RM_TOKENIZER=your-org/sql-selection-32b

# Outputs
LOG_FILE=logs/bird.log
EXPERIMENT_OUTPUT_DIR=experiments/bird
SAVE_INTERMEDIATE_RESULTS=true
SAVE_EXECUTION_RESULTS=false
SAVE_PHASE_SNAPSHOT=true
